# Copy this file to ".env" in the same folder (CandidateSearchAPI/.env) and fill in your values.
# Docker Compose reads .env automatically. The real .env is gitignored - never commit your API key.

# --- Option A: public OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here
# Leave blank for public OpenAI.
OPENAI_BASE_URL=
# Model names, e.g. gpt-4.1 or gpt-4.1-mini. OPENAI_MODEL reads resumes; OPENAI_QUERY_MODEL reads searches.
OPENAI_MODEL=gpt-4.1
OPENAI_QUERY_MODEL=gpt-4.1

# --- Option B: Azure OpenAI - replace the four lines above with these ---
# OPENAI_API_KEY=your-azure-openai-key
# OPENAI_BASE_URL=https://<your-resource-name>.openai.azure.com/openai/v1/
# On Azure these are your *deployment names* (Azure portal -> your OpenAI resource -> Deployments),
# not the public model names.
# OPENAI_MODEL=<your-deployment-name>
# OPENAI_QUERY_MODEL=<your-deployment-name>

# true runs without any AI (simple keyword stand-in) - useful to try the app without a key; results are basic.
MOCK_LLM=false
